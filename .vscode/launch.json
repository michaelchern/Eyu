{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Eyu: Debug active CMake target",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "osx": {
        "MIMode": "lldb"
      },
      "linux": {
        "MIMode": "gdb"
      },
      "windows": {
        "type": "cppvsdbg",
        "console": "integratedTerminal"
      }
    }
  ]
}
